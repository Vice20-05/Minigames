{
    // Ctrl+Shift+B = compile with javac and start the F1 game.
    // Works even if the Java extension gets confused, because it doesn't use it.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run F1 game (javac)",
            "type": "shell",
            "command": "javac -d out src/f1_game/f1Main.java src/f1_game/base/*.java && java -cp out f1_game.f1Main",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
